* text=auto

*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary

# Vendored trees are checksum-pinned upstream material. Preserve their bytes.
third_party/** -text
