prefix=/home/runner/work/bitwuzla/bitwuzla/build/install
includedir=${prefix}/include
libdir=${prefix}/lib/x86_64-linux-gnu

Name: bitwuzla
Description: bitwuzla: bitwuzla
Version: 0.9.1
Requires: gmp >= 6.3, mpfr >= 4.2.1
Libs: -L${libdir} -lbitwuzla -lbitwuzlals -lbitwuzlabv -lbitwuzlabb
Cflags: -I${includedir}
